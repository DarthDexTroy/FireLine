{
  "expo": {
    "name": "Fireline",
    "slug": "fireline",
    "scheme": "fireline",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fireline.demo"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Fireline"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
